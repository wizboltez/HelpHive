# Copy to .env and adjust. Every value is optional in development.

PORT=4000

# Leave empty to use the embedded PGlite database stored in PGLITE_DIR.
# For a real server: postgres://helphive:helphive@localhost:5432/helphive
DATABASE_URL=
PGLITE_DIR=.data/pglite
UPLOAD_DIR=.data/uploads

# REQUIRED in production — a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
TOKEN_TTL=7d

# Website address(es) allowed to call the API, comma separated, e.g. https://helphive.example.com
# Leave empty in development to allow any address (so teammates on your Wi-Fi can connect).
# Must be set in production.
CORS_ORIGIN=
# Set to true when running behind a reverse proxy
TRUST_PROXY=false
AUTH_RATE_LIMIT=20
# Email providers allowed at sign-up
ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com

# Business rules
TIMEZONE=Asia/Kolkata
CONVENIENCE_FEE=49
CANCEL_WINDOW_HOURS=24
MAX_DOOR_CODE_ATTEMPTS=5
MAX_UPLOAD_MB=5
